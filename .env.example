# Resend email service (required for contact form)
RESEND_API_KEY=re_xxxxxxxxxxxxx
CONTACT_FROM_EMAIL=contact@ezequielranieri.vercel.app
CONTACT_TO_EMAIL=ez.ranieri@gmail.com

# SITE_URL is defined in src/config/site.ts
# SITE_URL=https://ezequielranieri.vercel.app

# Upstash Redis — shared rate limiting for the contact form (optional).
# Without BOTH values the endpoint degrades to per-instance memory limiting.
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile — anti-bot challenge for the contact form (optional).
# Without BOTH values the widget is not rendered and verification is skipped.
PUBLIC_TURNSTILE_SITE_KEY=0xXXXXXXXXXXXXXXXXXXXX
TURNSTILE_SECRET_KEY=0xXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

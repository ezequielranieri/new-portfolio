---
import { url } from '@/lib/url';
import { SOCIAL } from '@/config/site';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { getTranslator, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
---

<!-- FIXED HEADER -->
<header class="fixed-header" role="banner">
  <a href={url('/', undefined, locale)} class="logo" aria-label={t('a11y.home')}>{t('brand.initials')}</a>
  <div class="header-end">
    <div class="header-switcher">
      <LanguageSwitcher currentLocale={locale} currentPath={Astro.url.pathname} hash={Astro.url.hash} />
    </div>
    <nav class="nav" aria-label={t('a11y.mainNavigation')}>
      <a href={url('/', 'projects', locale)} class="nav-link">{t('nav.projects')}</a>
      <a href={url('/', 'blog', locale)} class="nav-link">{t('nav.blog')}</a>
      <a href={url('/', 'how-i-work', locale)} class="nav-link">{t('nav.howIWork')}</a>
      <a href={url('/', 'contact', locale)} class="nav-link">{t('nav.contact')}</a>
    </nav>
    <button type="button" class="menu-toggle" hidden aria-label={t('a11y.menuOpen')} aria-expanded="false" aria-controls="mobile-menu">{t('home.menu.toggle')}</button>
  </div>
</header>

<!-- MOBILE MENU OVERLAY (< 1024px) -->
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label={t('a11y.mainNavigation')} hidden>
  <div class="mobile-menu-inner">
    <div class="mobile-menu-header">
      <button type="button" class="menu-close" aria-label={t('a11y.closeMenu')}>
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <nav class="mobile-menu-nav" aria-label={t('a11y.mainNavigation')}>
      <a href={url('/', 'projects', locale)} class="nav-link mobile-menu-link">{t('nav.projects')}</a>
      <a href={url('/', 'blog', locale)} class="nav-link mobile-menu-link">{t('nav.blog')}</a>
      <a href={url('/', 'how-i-work', locale)} class="nav-link mobile-menu-link">{t('nav.howIWork')}</a>
      <a href={url('/', 'contact', locale)} class="nav-link mobile-menu-link">{t('nav.contact')}</a>
    </nav>
    <div class="mobile-menu-social" aria-label={t('a11y.socialLinks')}>
      <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={t('a11y.githubProfile')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={t('a11y.linkedinProfile')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      {SOCIAL.x && (
        <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={t('a11y.xProfile')}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>
        </a>
      )}
      <div class="mobile-menu-switcher">
        <LanguageSwitcher currentLocale={locale} currentPath={Astro.url.pathname} hash={Astro.url.hash} />
      </div>
    </div>
  </div>
</div>

<script>
  // Smooth scroll for nav links // i18n-ignore
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', (e) => {
      const mq = window.matchMedia('(prefers-reduced-motion: reduce)'); // i18n-ignore
      const href = link.getAttribute('href');
      const id = (href || '').split('#')[1];
      const target = id ? document.getElementById(id) : null;
      // Only take over the click when the target section exists on this page;
      // otherwise let the browser navigate to the homepage anchor.
      if (!target) return; // i18n-ignore
      e.preventDefault();
      target.scrollIntoView({ behavior: mq.matches ? 'auto' : 'smooth' });
    });
  });
</script>
<script is:inline>
  // Header scrolled state (all screen sizes)
  (() => {
    const initHeaderScroll = () => {
      const header = document.querySelector('.fixed-header');
      if (!header) {
        // Retry after a short delay if header not found yet
        setTimeout(initHeaderScroll, 50);
        return;
      }
      const onScroll = () => {
        if (window.scrollY > 4) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeaderScroll);
    } else {
      // Use setTimeout to ensure DOM is ready
      setTimeout(initHeaderScroll, 0);
    }
  })();
</script>

<script>
  // Mobile menu (< 1024px) // i18n-ignore
  (() => {
    const mobileMQ = window.matchMedia('(max-width: 1023.98px)'); // i18n-ignore
    if (!mobileMQ.matches) return;

    const menuToggle = document.querySelector('.menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuClose = document.querySelector('.menu-close');
    const menuLinks = Array.from(document.querySelectorAll('.mobile-menu-link'));
    const focusableSelectors = 'a[href], button, [tabindex]:not([tabindex="-1"])'; // i18n-ignore
    let lastFocused: HTMLElement | null = null;
    let isOpen = false;

    const lockScroll = () => {
      document.documentElement.classList.add('menu-open');
    };
    const unlockScroll = () => {
      document.documentElement.classList.remove('menu-open');
    };

    const openMenu = () => {
      if (!mobileMenu) return;
      lastFocused = document.activeElement as HTMLElement | null;
      mobileMenu.hidden = false;
      menuToggle && menuToggle.setAttribute('aria-expanded', 'true');
      lockScroll();
      isOpen = true;
      // Fade in after display
      requestAnimationFrame(() => {
        mobileMenu.classList.add('is-open');
        const first = mobileMenu.querySelector(focusableSelectors);
        if (first instanceof HTMLElement) {
          setTimeout(() => first.focus(), 50);
        }
      });
    };

    const closeMenu = () => {
      if (!mobileMenu) return;
      mobileMenu.classList.remove('is-open');
      menuToggle && menuToggle.setAttribute('aria-expanded', 'false');
      unlockScroll();
      isOpen = false;
      // Hide after transition; keep simple timeout
      setTimeout(() => {
        if (!isOpen) {
          mobileMenu.hidden = true;
          if (lastFocused instanceof HTMLElement) {
            lastFocused.focus();
          }
        }
      }, 220);
    };

    menuToggle && menuToggle.addEventListener('click', (e) => {
      e.preventDefault();
      if (mobileMenu && mobileMenu.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menuClose && menuClose.addEventListener('click', (e) => {
      e.preventDefault();
      closeMenu();
    });

    menuLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (!mobileMenu || mobileMenu.hidden || !mobileMenu.classList.contains('is-open')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeMenu();
        return;
      }
      if (e.key === 'Tab') {
        const focusables = Array.from(mobileMenu.querySelectorAll(focusableSelectors)).filter((el) => {
          return el instanceof HTMLElement && el.offsetWidth > 0 && el.offsetHeight > 0 && !el.hidden && el.getAttribute('aria-hidden') !== 'true';
        });
        if (focusables.length === 0) return;
        const first = focusables[0] as HTMLElement;
        const last = focusables[focusables.length - 1] as HTMLElement;
        const active = document.activeElement;
        if (e.shiftKey) {
          if (active === first || !mobileMenu.contains(active)) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (active === last || !mobileMenu.contains(active)) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });

    mobileMenu && mobileMenu.addEventListener('click', (e) => {
      // Close on a backdrop click: anything that is not a link/button.
      const target = e.target;
      if (target instanceof Element && target.closest('a, button')) return; // i18n-ignore
      closeMenu();
    });
  })();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackToTop from '@/components/BackToTop.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import LangTag from './LangTag.astro';
import { getCanonicalUrl, formatDisplayDate, formatDateTime, getModifiedDate } from '@/lib/blog';
import type { BlogPost } from '@/lib/blog';
import { SITE_URL, SITE_NAME } from '@/config/site';
import { url } from '@/lib/url';
import { getTranslator, type Locale } from '@/i18n';
import { buildArticleJsonLd } from '@/lib/jsonld';
import { articleOgImage } from '@/lib/og';

interface Props {
  locale: Locale;
  post: BlogPost;
  body: any;
  prev: { title: string; url: string } | null;
  next: { title: string; url: string } | null;
  postIndex: number;
  contentLocale: Locale;
  otherLocaleHref?: string;
  alternates?: { locale: Locale; url: string }[];
}

const { locale, post, body, prev, next, postIndex, contentLocale, otherLocaleHref, alternates = [] } = Astro.props;
const t = getTranslator(locale);

const canonicalURL = getCanonicalUrl(locale, post.slug);
const ogTitle = `${post.title} · ${SITE_NAME}`;
const ogDescription = post.excerpt;
// Card generated from the title that is actually rendered: post.lang, not the
// route locale, because an untranslated body is shown in its own language.
const ogImage = articleOgImage(post.lang, post.slug);

// Fallback indicator: the article body is in another locale than the page.
const showFallbackTag = contentLocale !== locale;

// Revision marker: only when a manual `updatedDate` exists and post-dates publication.
const showUpdatedDate = !!post.updatedDate && post.updatedDate.getTime() > post.date.getTime();

// A body with no readable text has nothing to time.
const bodyHasContent =
  String(body ?? '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/<[^>]*>/g, '')
    .replace(/&nbsp;/gi, ' ')
    .trim().length > 0;

// JSON-LD Article — reuses the page canonical so both always agree
const jsonLd = buildArticleJsonLd(post, canonicalURL);

// Extract h2 headings for TOC (server-side from HTML)
// Match h2 with or without ID - if no ID, generate one from text
const headingRegex = /<h2[^>]*>([^<]+)<\/h2>/g;
const headings: { id: string; text: string }[] = [];
let match;
// First pass: collect headings with 1-based index
while ((match = headingRegex.exec(String(body))) !== null) {
  const text = match[1].trim();
  const index = headings.length + 1;
  const id = `heading-${index}`;
  headings.push({ id, text });
}

// Add IDs to h2 elements in the HTML body for anchor linking, and remove <hr> elements
let processedBody = String(body)
  .replace(/<hr\s*\/?>/gi, '') // Remove <hr> elements that create duplicate dividers
  .replace(headingRegex, (fullMatch, text) => {
    const index = headings.findIndex(h => h.text === text.trim()) + 1;
    const id = `heading-${index}`;
    // Only add ID if not already present
    if (fullMatch.includes('id=')) return fullMatch; // i18n-ignore
    return fullMatch.replace('<h2', `<h2 id="${id}"`); // i18n-ignore
  });
---

<style>
  /* ===== LAYOUT ===== */
  .article {
    padding-top: calc(var(--header-h) + var(--section-top));
  }

  /* Same container as blog index: --container max-width, centered, page-x padding */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    width: calc(100% - 2 * var(--page-x));
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--page-x);
  }

  .article-main {
    min-width: 0;
  }

  .article-toc {
    display: none; /* hidden by default, shown via media queries */
  }

  /* ===== HEADER SCROLLED STATE + READING PROGRESS (article pages only) ===== */
  /* The progress bar is drawn ON the header's border-bottom when scrolled.
     No separate track element. Only on article pages.
     Positioned fixed at header bottom, only visible when header has .is-scrolled. */
  .reading-progress-bar {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    height: 2px;
    width: 0%;
    background: var(--chrome-gradient);
    background-size: var(--chrome-text-bg-size);
    animation: chrome-shift var(--chrome-text-duration) var(--chrome-text-ease) infinite alternate;
    will-change: background-position, width;
    transition: width 50ms linear, opacity 200ms var(--ease), visibility 200ms var(--ease);
    pointer-events: none;
    z-index: var(--z-fixed);
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress-bar {
      animation: none;
      background-position: 50% 50%;
      transition: width 50ms linear, opacity 200ms var(--ease), visibility 200ms var(--ease);
    }
  }

  /* ===== TOC SIDEBAR (base styles for mobile ≤1179.98px) ===== */
  .article-toc {
    display: block;
    position: sticky;
    top: var(--header-h);
    max-height: none;
    overflow: visible;
    padding: 0;
    border-right: none;
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-6);
    background: var(--bg);
    z-index: var(--z-fixed);
  }

  .toc-nav {
    padding: var(--space-4) 0;
  }

  .toc-title {
    font-family: var(--font-body);
    font-size: var(--micro-size);
    font-weight: var(--micro-weight);
    letter-spacing: var(--micro-tracking);
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: var(--space-4);
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  .toc-item {
    position: relative;
    padding-left: var(--space-3);
    transition: border-color var(--transition-fast);
  }

  /* Active item: vertical gradient bar on the left */
  .toc-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--chrome-gradient);
    background-size: var(--chrome-text-bg-size);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-item::before {
      transition: none;
      animation: none;
      background-position: 50% 50%;
    }
  }

  .toc-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--small-size);
    line-height: var(--small-line);
    color: var(--text-3);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: var(--space-1) 0;
  }

  .toc-link:hover {
    color: var(--text);
  }

  .toc-link.is-active {
    color: var(--text);
    font-weight: 500;
  }

  /* Active item: show the gradient bar */
  .toc-item.is-active::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .toc-number {
    font-family: var(--font-body);
    font-size: var(--micro-size);
    font-weight: var(--micro-weight);
    letter-spacing: var(--micro-tracking);
    color: var(--text-4);
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .toc-link.is-active .toc-number {
    color: var(--chrome-cyan);
  }

  .toc-text {
    max-width: 180px;
    min-width: 0; /* Allow flex item to shrink */
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (max-width: 1023.98px) {
    .toc-text {
      max-width: none; /* Remove max-width constraint on mobile */
    }
  }

  /* ===== MOBILE TOC: Compact sticky bar ===== */
  .toc-mobile-trigger {
    display: none;
  }

  .toc-mobile-panel {
    display: none;
  }

  @media (max-width: 1179.98px) {
    .article-toc {
      position: sticky;
      top: var(--header-h);
      z-index: var(--z-fixed);
      background: var(--bg);
      border-right: none;
      border-bottom: 1px solid var(--line);
      padding: 0;
      margin-bottom: var(--space-6);
      max-height: none;
      overflow: visible;
    }

    .toc-nav {
      padding: 0;
    }

    .toc-title {
      display: none;
    }


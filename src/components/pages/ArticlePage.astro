    }

    .toc-mobile-trigger:hover,
    .toc-mobile-trigger:focus-visible {
      border-color: var(--chrome-cyan);
      background: var(--surface-hover);
    }

    .toc-mobile-trigger:focus-visible {
      outline: 2px solid var(--text);
      outline-offset: 2px;
    }

    .toc-mobile-current {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--text);
      font-family: var(--font-body);
      font-size: var(--small-size);
      line-height: var(--small-line);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .toc-mobile-current-number {
      font-family: var(--font-body);
      font-size: var(--micro-size);
      font-weight: var(--micro-weight);
      letter-spacing: var(--micro-tracking);
      text-transform: uppercase;
      color: var(--chrome-cyan);
    }

    .toc-mobile-arrow {
      display: inline-flex;
      flex-shrink: 0;
      width: 16px;
      height: 16px;
      color: var(--text-3);
      transition: transform var(--transition-fast), color var(--transition-fast);
    }

    .toc-mobile-trigger[aria-expanded="true"] .toc-mobile-arrow {
      transform: rotate(180deg);
      color: var(--text);
    }

    @media (prefers-reduced-motion: reduce) {
      .toc-mobile-arrow {
        transition: none;
      }
    }
  }

  /* ===== DESKTOP: Two-column layout with fixed TOC sidebar (≥1180px) ===== */
  @media (min-width: 1180px) {
    .article-layout {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: var(--space-16);

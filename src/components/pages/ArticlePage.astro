  /* ===== ARTICLE HEADER ===== */
  .article-header {
    margin-bottom: var(--gap-header-body);
  }

  .article-eyebrow {
    margin-bottom: var(--space-2);
    white-space: nowrap;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);

    }

    /* Desktop TOC link styles (override mobile panel styles) */
    .toc-list {
      display: flex !important;
    }

    .toc-title {
      display: block !important;
    }

    .toc-link {
      display: flex;
      align-items: baseline;
      padding: var(--space-1) 0;
      background: transparent;
      border: none;
      min-height: auto;
      color: var(--text-3);

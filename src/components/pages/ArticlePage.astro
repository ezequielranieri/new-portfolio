    }

    .toc-link:hover {
      color: var(--text);
      background: transparent;
    }

    .toc-link.is-active {
      border-color: transparent;
      color: var(--text);
      font-weight: 500;
    }

    .toc-number {
      color: var(--text-4);
    }

    .toc-link.is-active .toc-number {
      color: var(--chrome-cyan);
    }

    .toc-mobile-trigger {
      display: none !important;
    }

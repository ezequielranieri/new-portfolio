---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHomepagePosts } from '@/lib/blog';
import { PROJECT_REPOS, SOCIAL, CONTACT_EMAIL, CONTACT_LOCATION } from '@/config/site';
import { url, absoluteUrl } from '@/lib/url';
import SiteHeader from '@/components/SiteHeader.astro';
import BackToTop from '@/components/BackToTop.astro';
import BlogRow from '@/components/BlogRow.astro';
import { getTranslator, type Locale } from '@/i18n';
import { buildHomeJsonLd } from '@/lib/jsonld';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale);

// Identity graph for search engines. The job title and description come from
// the dictionaries so the ES page describes the ES person, not a copy of the EN.
const homeJsonLd = buildHomeJsonLd(locale, t('hero.role'), t('home.meta.description'));

// Turnstile is optional: without the site key the widget is not rendered and
// the server skips verification, so local development needs no credentials.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// Project repo URLs — centralised in config
const REPOS = PROJECT_REPOS;

// The three newest posts, newest first — the same order and the same
// numbering the blog index and the article page use.
const HOMEPAGE_POSTS = await getHomepagePosts(locale);

type HIWItem =
  | string
  | { name: string; text: string }
  | { label: string; text: string }
  | { name: string; issuer: string };

interface HIWCategory {
  id: string;
  name: string;
  kind: 'principles' | 'steps' | 'stack' | 'certifications';
  items: HIWItem[];
}

// Edit these to change the HOW I WORK copy. Counts are derived from the arrays.
const HOW_I_WORK: HIWCategory[] = [
  {
    id: 'principles',
    name: t('home.howIWork.categories.principles.name'),
    kind: 'principles',
    items: [
      { name: t('home.howIWork.categories.principles.items.securityFirst.name'), text: t('home.howIWork.categories.principles.items.securityFirst.text') },
      { name: t('home.howIWork.categories.principles.items.hexagonalArchitecture.name'), text: t('home.howIWork.categories.principles.items.hexagonalArchitecture.text') },
      { name: t('home.howIWork.categories.principles.items.testingAsSpecification.name'), text: t('home.howIWork.categories.principles.items.testingAsSpecification.text') },
      { name: t('home.howIWork.categories.principles.items.nativeObservability.name'), text: t('home.howIWork.categories.principles.items.nativeObservability.text') },
      { name: t('home.howIWork.categories.principles.items.simplicityOverCleverness.name'), text: t('home.howIWork.categories.principles.items.simplicityOverCleverness.text') },
      { name: t('home.howIWork.categories.principles.items.livingDocumentation.name'), text: t('home.howIWork.categories.principles.items.livingDocumentation.text') },
    ],
  },
  {
    id: 'methodology',
    name: t('home.howIWork.categories.methodology.name'),
    kind: 'steps',
    items: [
      t('home.howIWork.categories.methodology.items.exploreFirst'),
      t('home.howIWork.categories.methodology.items.specifyExplicitly'),
      t('home.howIWork.categories.methodology.items.implementInVerticalSlices'),
      t('home.howIWork.categories.methodology.items.verifyAutomatically'),
      t('home.howIWork.categories.methodology.items.reviewWithJudgment'),
      t('home.howIWork.categories.methodology.items.deliverInWorkUnitCommits'),
    ],
  },
  {
    id: 'stack',
    name: t('home.howIWork.categories.stack.name'),
    kind: 'stack',
    items: [
      { label: t('home.stack.languages.label'), text: t('home.stack.languages.text') },
      { label: t('home.stack.runtimeInfra.label'), text: t('home.stack.runtimeInfra.text') },
      { label: t('home.stack.security.label'), text: t('home.stack.security.text') },
      { label: t('home.stack.observability.label'), text: t('home.stack.observability.text') },
      { label: t('home.stack.testing.label'), text: t('home.stack.testing.text') },
      { label: t('home.stack.tooling.label'), text: t('home.stack.tooling.text') },
    ],
  },
  {
    id: 'certifications',
    name: t('home.howIWork.categories.certifications.name'),
    kind: 'certifications',
    items: [
      { name: t('home.certifications.developingSecureSoftware.name'), issuer: t('home.certifications.developingSecureSoftware.issuer') },
      { name: t('home.certifications.secureAiMlDrivenSoftwareDevelopment.name'), issuer: t('home.certifications.secureAiMlDrivenSoftwareDevelopment.issuer') },
    ],
  },
];
---

<BaseLayout
  title={t('home.meta.title')}
  description={t('home.meta.description')}
  canonicalURL={absoluteUrl('/', locale)}
  locale={locale}
  alternates={[
    { locale: 'en', url: absoluteUrl('/') },
    { locale: 'es', url: absoluteUrl('/es/') },
  ]}
>

  <!-- SEO: JSON-LD Person + WebSite (localized per page) -->
  <script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)}></script>

  <!-- FIXED HEADER -->
  <SiteHeader locale={locale} />

  <!-- FIXED SOCIAL ICONS (bottom-left) -->
  <div class="fixed-social" aria-label={t('a11y.socialLinks')}>
    <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={t('a11y.githubProfile')}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
    </a>
    <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={t('a11y.linkedinProfile')}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
    </a>
    {SOCIAL.x && (
      <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={t('a11y.xProfile')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>
      </a>
    )}
  </div>

  <!-- FIXED SCROLL INDICATOR (bottom-right) -->
  <div class="fixed-scroll" aria-hidden="true">
    <span class="scroll-text">{t('hero.scroll')}</span>
    <span class="scroll-line" aria-hidden="true"></span>
  </div>

  <!-- BACK TO TOP (bottom-right; swaps in for the scroll indicator on the last section) -->
  <BackToTop locale={locale} />

  <!-- Skip-link destination: one focus target for the whole page body.
       tabindex="-1" makes it programmatically focusable without adding it to
       the tab order. -->
  <main id="main" tabindex="-1">
  <!-- SECTION 1: HERO -->
  <section id="hero" class="section hero" aria-labelledby="hero-name">
    <div class="hero-container">
      <p class="hero-label" aria-hidden="true">{t('hero.iam')}</p>
      <h1 id="hero-name" class="hero-name">
        <span class="visually-hidden">{t('brand.fullName')}</span>
        <span class="hero-name-text chrome-text" aria-hidden="true">{t('hero.heroName')}</span>
      </h1>
      <p class="hero-role">{t('hero.role')}</p>
    </div>
    <!-- Inline SCROLL indicator (< 1024px only; `hidden` keeps it off desktop) -->
    <div class="hero-scroll" hidden aria-hidden="true">
      <span class="scroll-text">{t('hero.scroll')}</span>
      <span class="scroll-line" aria-hidden="true"></span>
    </div>
  </section>

  <!-- SECTION 2: PORTFOLIO -->
  <section id="projects" class="section portfolio" aria-labelledby="portfolio-title">
    <div class="portfolio-inner">
      <div class="project-row">

        <!-- 01 · AEGIS -->
        <a class="project-card chrome-border-hover" href={REPOS.aegis} target="_blank" rel="noopener noreferrer">
          <span class="project-card-inner">
            <span class="project-card-head">
            <span class="project-card-index">01</span>
            <svg class="project-card-arrow" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <path d="M3 9 9 3M4.2 3H9v4.8" />
            </svg>
          </span>
          <span class="project-card-art" aria-hidden="true">
            <svg viewBox="0 0 120 120" fill="none" stroke="#e8e8ea" stroke-width="1" xmlns="http://www.w3.org/2000/svg">
              <rect x="6.5" y="6.5" width="107" height="107" opacity="0.3" />
              <rect x="20.5" y="20.5" width="79" height="79" opacity="0.5" />
              <rect x="34.5" y="34.5" width="51" height="51" />
              <rect x="48.5" y="48.5" width="23" height="23" />
              <rect x="55" y="55" width="10" height="10" fill="#e8e8ea" stroke="none" />
            </svg>
          </span>
          <span class="project-card-meta">
            <span class="project-card-name">{t('home.projects.aegis.name')}</span>
            <span class="project-card-label">{t('home.projects.aegis.label')}</span>
          </span>
        </span>
        </a>

        <!-- 02 · AGENT GATEWAY (centre, flagship) -->
        <a class="project-card project-card--featured chrome-border-hover" href={REPOS.agentGateway} target="_blank" rel="noopener noreferrer">
          <span class="project-card-inner">
            <span class="project-card-head">
            <span class="project-card-index">02</span>
            <svg class="project-card-arrow" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <path d="M3 9 9 3M4.2 3H9v4.8" />
            </svg>
          </span>
          <span class="project-card-art" aria-hidden="true">
            <svg viewBox="0 0 160 140" fill="none" stroke="#e8e8ea" stroke-width="1" xmlns="http://www.w3.org/2000/svg">
              <g opacity="0.3">
                <rect x="4.5" y="16.5" width="9" height="9" />
                <rect x="4.5" y="48.5" width="9" height="9" />
                <rect x="4.5" y="80.5" width="9" height="9" />
                <rect x="4.5" y="112.5" width="9" height="9" />
                <rect x="146.5" y="16.5" width="9" height="9" />
                <rect x="146.5" y="48.5" width="9" height="9" />
                <rect x="146.5" y="80.5" width="9" height="9" />
                <rect x="146.5" y="112.5" width="9" height="9" />
              </g>
              <g opacity="0.45">
                <path d="M13.5 21 60.5 58" />
                <path d="M13.5 53 60.5 67" />
                <path d="M13.5 85 60.5 77" />
                <path d="M13.5 117 60.5 86" />
                <path d="M146.5 21 99.5 58" />
                <path d="M146.5 53 99.5 67" />
                <path d="M146.5 85 99.5 77" />
                <path d="M146.5 117 99.5 86" />
              </g>
              <rect x="60.5" y="52.5" width="39" height="39" />
            </svg>
          </span>
          <span class="project-card-meta">
            <span class="project-card-name">{t('home.projects.agentGateway.name')}</span>
            <span class="project-card-label">{t('home.projects.agentGateway.label')}</span>
          </span>
        </span>
        </a>

        <!-- 03 · METTLE -->
        <a class="project-card chrome-border-hover" href={REPOS.mettle} target="_blank" rel="noopener noreferrer">
          <span class="project-card-inner">
            <span class="project-card-head">
            <span class="project-card-index">03</span>
            <svg class="project-card-arrow" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <path d="M3 9 9 3M4.2 3H9v4.8" />
            </svg>
          </span>
          <span class="project-card-art" aria-hidden="true">
            <svg viewBox="0 0 120 120" fill="none" stroke="#e8e8ea" stroke-width="1" xmlns="http://www.w3.org/2000/svg">
              <g opacity="0.3">
                <rect x="12.5" y="12.5" width="12" height="12" />
                <rect x="36.5" y="12.5" width="12" height="12" />
                <rect x="60.5" y="12.5" width="12" height="12" />
                <rect x="84.5" y="12.5" width="12" height="12" />
                <rect x="12.5" y="36.5" width="12" height="12" />
                <rect x="36.5" y="36.5" width="12" height="12" />
                <rect x="60.5" y="36.5" width="12" height="12" />
                <rect x="84.5" y="36.5" width="12" height="12" />
                <rect x="12.5" y="60.5" width="12" height="12" />
                <rect x="36.5" y="60.5" width="12" height="12" />
                <rect x="60.5" y="60.5" width="12" height="12" />
                <rect x="84.5" y="60.5" width="12" height="12" />
                <rect x="12.5" y="84.5" width="12" height="12" />
                <rect x="36.5" y="84.5" width="12" height="12" />
                <rect x="60.5" y="84.5" width="12" height="12" />
                <rect x="84.5" y="84.5" width="12" height="12" />
                <path d="M12 104H108" />
              </g>
              <rect x="36.5" y="12.5" width="12" height="12" fill="#e8e8ea" stroke="none" />
              <rect x="60.5" y="36.5" width="12" height="12" fill="#e8e8ea" stroke="none" />
              <rect x="12.5" y="60.5" width="12" height="12" fill="#e8e8ea" stroke="none" />
              <rect x="84.5" y="84.5" width="12" height="12" fill="#e8e8ea" stroke="none" />
              <path d="M12 104H54" />
              <path d="M54 99V109" />
            </svg>
          </span>
          <span class="project-card-meta">
            <span class="project-card-name">{t('home.projects.mettle.name')}</span>
            <span class="project-card-label">{t("home.projects.mettle.label")}</span>
          </span>
        </span></a>
      </div>

      <div class="portfolio-caption">
        <h2 id="portfolio-title" class="portfolio-title">{t('home.portfolio.title')}</h2>
        <p class="portfolio-subtitle">{t('home.portfolio.subtitle')}</p>
        <a class="portfolio-cta btn" href="https://github.com/ezequielranieri" target="_blank" rel="noopener noreferrer">{t('home.portfolio.cta')}</a>
      </div>

      <!-- Carousel dots (< 1024px only; `hidden` keeps them off desktop) -->
      <div class="portfolio-dots" hidden>
        <button type="button" class="portfolio-dot" aria-label={t('a11y.project1of3')} aria-current="true"></button>
        <button type="button" class="portfolio-dot" aria-label={t('a11y.project2of3')}></button>
        <button type="button" class="portfolio-dot" aria-label={t('a11y.project3of3')}></button>
      </div>
    </div>
  </section>

  <!-- SECTION 3: BLOG -->
  <section id="blog" class="section blog" aria-labelledby="blog-title">
    <div class="blog-content">
      <header class="blog-header">
        <h2 id="blog-title" class="blog-title">{t('nav.blog')}</h2>
        <p class="blog-subtitle">{t('home.blog.subtitle')}</p>
      </header>

      {HOMEPAGE_POSTS.length > 0 ? (
        <>
          <div class="blog-list">
            {HOMEPAGE_POSTS.map((item, index) => (
              <BlogRow item={item} locale={locale} number={index + 1} headingLevel={3} />
            ))}
          </div>
          <a class="blog-cta btn" href={url('/blog', undefined, locale)}>{t('home.blog.cta')}</a>
        </>
      ) : (
        <p class="blog-subtitle blog-empty-home">{t('home.blog.emptyHome')}</p>
      )}
    </div>
  </section>

  <!-- SECTION 4: HOW I WORK -->
  <section id="how-i-work" class="section how-i-work" aria-labelledby="hiw-title">
    <div class="hiw-content">
      <header class="hiw-header">
        <h2 id="hiw-title" class="hiw-title">{t('nav.howIWork')}</h2>
        <p class="hiw-subtitle">{t('home.howIWork.subtitle')}</p>
      </header>

      <div class="hiw-layout">
        <div class="hiw-menu" role="tablist" aria-orientation="vertical" aria-label={t('a11y.mainNavigation')}>
          {HOW_I_WORK.map((cat, i) => (
            <button
              class="hiw-tab"
              role="tab"
              type="button"
              id={`hiw-tab-${cat.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`hiw-panel-${cat.id}`}
              tabindex={i === 0 ? '0' : '-1'}
            >
              <span class="hiw-tab-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="hiw-tab-name">{cat.name}</span>
            </button>
          ))}
        </div>

        <div class="hiw-panels">
          {HOW_I_WORK.map((cat, i) => (
            <div
              class="hiw-panel"
              role="tabpanel"
              id={`hiw-panel-${cat.id}`}
              aria-labelledby={`hiw-tab-${cat.id}`}
              tabindex="0"
              hidden={i !== 0}
            >
              {cat.kind === 'principles' && (
                <div class="hiw-principles">
                  {(cat.items as { name: string; text: string }[]).map((p) => (
                    <div class="hiw-principle">
                      <span class="hiw-principle-name">{p.name}</span>
                      <span class="hiw-principle-text">{p.text}</span>
                    </div>
                  ))}
                </div>
              )}
              {cat.kind === 'steps' && (
                <div class="hiw-steps">
                  {(cat.items as string[]).map((s, si) => (
                    <div class="hiw-step">
                      <span class="hiw-step-num">{String(si + 1).padStart(2, '0')}</span>
                      <span class="hiw-step-text">{s}</span>
                    </div>
                  ))}
                </div>
              )}
              {cat.kind === 'stack' && (
                <div class="hiw-stack">
                  {(cat.items as { label: string; text: string }[]).map((g) => (
                    <div class="hiw-stack-group">
                      <span class="hiw-stack-label">{g.label}</span>
                      <span class="hiw-stack-items">{g.text}</span>
                    </div>
                  ))}
                </div>
              )}
              {cat.kind === 'certifications' && (
                <div class="hiw-certs">
                  {(cat.items as { name: string; issuer: string }[]).map((c) => (
                    <div class="hiw-cert">
                      <span class="hiw-cert-name">{c.name}</span>
                      <span class="hiw-cert-issuer">{c.issuer}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: CONTACT -->
  <section id="contact" class="section contact" aria-labelledby="contact-heading">
    <div class="contact-content">
      <div class="contact-header">
        <h2 id="contact-heading" class="contact-title">{t('nav.contact')}</h2>
        <p class="contact-subtitle">{t('home.contact.subtitle')}</p>
      </div>
      <div class="contact-layout">
        <div class="contact-left">
          <p class="contact-description">{t('home.contact.description')}</p>
          <div class="contact-info">
            <div class="contact-info-item">
              <span class="contact-info-label">{t('home.contact.info.addressLabel')}</span>
              <address class="contact-info-value">{CONTACT_LOCATION}</address>
            </div>
            <div class="contact-info-item">
              <span class="contact-info-label">{t('home.contact.info.emailLabel')}</span>
              <a href={SOCIAL.email} class="contact-info-value contact-info-link">{CONTACT_EMAIL}</a>
            </div>
          </div>
        </div>
        <div class="contact-right">
          <form class="contact-form" novalidate>
            <div class="form-row">
              <div class="form-field">
                <label class="form-label" for="contact-name">{t('home.contact.form.nameLabel')}</label>
                <input
                  id="contact-name"
                  class="form-input"
                  type="text"
                  name="name"
                  placeholder={t('home.contact.form.namePlaceholder')}
                  autocomplete="name"
                  data-1p-ignore
                  data-lpignore="true"
                  data-bwignore
                  data-form-type="other"
                  aria-describedby="contact-name-error"
                />
                <p id="contact-name-error" class="form-error" hidden></p>
              </div>
              <div class="form-field">
                <label class="form-label" for="contact-phone">{t('home.contact.form.phoneLabel')}</label>
                <input
                  id="contact-phone"
                  class="form-input"
                  type="tel"
                  name="phone"
                  placeholder={t('home.contact.form.phonePlaceholder')}
                  autocomplete="tel"
                  data-1p-ignore
                  data-lpignore="true"
                  data-bwignore
                  data-form-type="other"
                />
              </div>
            </div>
            <div class="form-field">
              <label class="form-label" for="contact-email">{t('home.contact.form.emailLabel')}</label>
              <input
                id="contact-email"
                class="form-input"
                type="email"
                name="email"
                placeholder={t('home.contact.form.emailPlaceholder')}
                autocomplete="email"
                inputmode="email"
                data-1p-ignore
                data-lpignore="true"
                data-bwignore
                data-form-type="other"
                aria-describedby="contact-email-error"
              />
              <p id="contact-email-error" class="form-error" hidden></p>
            </div>

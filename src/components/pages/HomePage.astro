  <script>
    // HOW I WORK — tabbed menu (desktop) / accordion (mobile). // i18n-ignore
    (() => {
      const tabs = Array.from(document.querySelectorAll('.hiw-tab'));
      if (!tabs.length) return;

      const panels = tabs.map((tab) => {
        const id = tab.getAttribute('aria-controls');
        return id ? document.getElementById(id) : null;
      });

      const hasFinePointer = () => window.matchMedia('(pointer: fine)').matches; // i18n-ignore

      const select = (index) => {
        tabs.forEach((tab, i) => {
          const selected = i === index;
          tab.setAttribute('aria-selected', selected ? 'true' : 'false');
          tab.setAttribute('aria-expanded', selected ? 'true' : 'false');
          tab.tabIndex = selected ? 0 : -1;

          const panel = panels[i];
          if (!panel) return;
          if (selected) {
            panel.removeAttribute('hidden');
            panel.tabIndex = 0;
          } else {
            panel.setAttribute('hidden', '');
            panel.tabIndex = -1;
          }
        });
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));

        tab.addEventListener('mouseenter', () => {
          if (hasFinePointer()) select(i);
        });

        tab.addEventListener('keydown', (event) => {
          let next = null;
          if (event.key === 'ArrowDown') next = Math.min(i + 1, tabs.length - 1);
          else if (event.key === 'ArrowUp') next = Math.max(i - 1, 0);
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          if (next === null) return;
          event.preventDefault();
          select(next);
          tabs[next].focus();
        });
      });

      select(0);
    })();
  </script>

  <script define:vars={{ 
    locale,
    validationNameRequired: t('home.contact.form.validation.nameRequired'),
    validationEmailInvalid: t('home.contact.form.validation.emailInvalid'),
    validationMessageMinLength: t('home.contact.form.validation.messageMinLength'),
    validationCaptchaRequired: t('home.contact.form.validation.captchaRequired'),
    statusSuccess: t('home.contact.form.status.success'),
    statusError: t('home.contact.form.status.error'),
    sendingText: t('home.contact.form.sending'),
  }}>
    // CONTACT form — client-side validation + JSON POST to /api/contact // i18n-ignore
    (() => {
      const form = document.querySelector('.contact-form');
      if (!form) return;

      const status = document.querySelector('.form-status');
      const button = form.querySelector('.btn-form');
      const fields = {
        name: form.querySelector('#contact-name'),
        email: form.querySelector('#contact-email'),
        message: form.querySelector('#contact-message'),
      };
      const honeypot = form.querySelector('input[name="_gotcha"]');
      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      const setError = (key, text) => {
        const field = fields[key];
        if (!field) return;
        const errorEl = document.getElementById(`${field.id}-error`);
        if (text) {
          field.setAttribute('aria-invalid', 'true');
          if (errorEl) {
            errorEl.textContent = text;
            errorEl.hidden = false;
          }
        } else {
          field.removeAttribute('aria-invalid');
          if (errorEl) {
            errorEl.textContent = '';
            errorEl.hidden = true;
          }
        }
      };

      const validate = () => {
        let ok = true;
        if (!fields.name.value.trim()) {
          setError('name', validationNameRequired);
          ok = false;
        } else {
          setError('name', '');
        }
        if (!EMAIL_RE.test(fields.email.value.trim())) {
          setError('email', validationEmailInvalid);
          ok = false;
        } else {
          setError('email', '');
        }
        if (fields.message.value.trim().length < 10) {
          setError('message', validationMessageMinLength);
          ok = false;
        } else {
          setError('message', '');
        }
        return ok;
      };

      const setStatus = (text, success) => {
        status.textContent = text;
        status.classList.toggle('is-success', Boolean(success));
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        // Honeypot: a filled hidden field means a bot. Silently succeed.
        if (honeypot && honeypot.value.trim()) {
          form.hidden = true;
          setStatus(statusSuccess, true);
          return;
        }

        if (!validate()) return;

        // Turnstile injects `cf-turnstile-response` into the form. Only enforce
        // it when the widget is actually present (no site key = no widget).
        const captchaField = form.querySelector('[name="cf-turnstile-response"]');
        if (captchaField && !String(captchaField.value || '').trim()) {
          setStatus(validationCaptchaRequired, false);
          return;
        }

        const originalLabel = button.textContent;
        button.disabled = true;
        button.textContent = sendingText;
        setStatus('');

        try {
          const response = await fetch('/api/contact/?locale=' + locale, {
            method: 'POST', // i18n-ignore
            headers: {
              'Content-Type': 'application/json', // i18n-ignore
              Accept: 'application/json', // i18n-ignore
            },
            body: JSON.stringify({
              name: fields.name.value.trim(),
              phone: form.querySelector('#contact-phone').value.trim(),
              email: fields.email.value.trim(),
              message: fields.message.value.trim(),
              turnstileToken: captchaField ? captchaField.value : undefined,
            }),
          });

          if (!response.ok) throw new Error(`Request failed: ${response.status}`); // i18n-ignore

          form.hidden = true;
          setStatus(statusSuccess, true);
        } catch (error) {
          button.disabled = false;
          button.textContent = originalLabel;
          setStatus(statusError, false);
        }
      });
    })();
  </script>
  <script>
    // PORTFOLIO carousel dots (< 1024px). // i18n-ignore One dot per card, kept in sync with the
    // carousel's scroll position, each dot scrolling its card into view.
    (() => {
      const mobileMQ = window.matchMedia('(max-width: 1023.98px)'); // i18n-ignore
      if (!mobileMQ.matches) return;

      const row = document.querySelector('.project-row');
      const dotsWrap = document.querySelector('.portfolio-dots');
      if (!row || !dotsWrap) return;

      const dots = Array.from(dotsWrap.querySelectorAll('.portfolio-dot'));
      // Visual order: the featured card carries `order: -1` on mobile, so sort by
      // the resolved order value (a stable sort keeps the two plain cards in DOM
      // order).
      const cards = Array.from(row.querySelectorAll('.project-card')).sort(
        (a, b) => (parseInt(getComputedStyle(a).order, 10) || 0) - (parseInt(getComputedStyle(b).order, 10) || 0)
      );
      if (!cards.length || cards.length !== dots.length) return;

      const prefersReduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches; // i18n-ignore

      const setActive = (index) => {
        dots.forEach((dot, i) => {
          if (i === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      const ratios = new Map();
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => ratios.set(entry.target, entry.intersectionRatio));
          let best = 0;
          let bestRatio = -1;
          cards.forEach((card, i) => {
            const ratio = ratios.get(card) || 0;
            if (ratio > bestRatio) {
              bestRatio = ratio;
              best = i;
            }
          });
          setActive(best);
        },
        { root: row, threshold: [0, 0.25, 0.5, 0.75, 1] }
      );

      cards.forEach((card) => observer.observe(card));

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          cards[i].scrollIntoView({
            behavior: prefersReduced() ? 'auto' : 'smooth',
            block: 'nearest',
            inline: 'start',
          });
        });
      });

      setActive(0);
    })();
  </script>

  <!-- Project card spotlight tracking -->
  <script>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) { // i18n-ignore
      const cards = document.querySelectorAll('.project-card');
      cards.forEach(card => {
        let rafId = null;
        const updateSpotlight = (x, y) => {
          const rect = card.getBoundingClientRect();
          const mx = x - rect.left;
          const my = y - rect.top;
          (card as HTMLElement).style.setProperty('--mx', mx + 'px');
          (card as HTMLElement).style.setProperty('--my', my + 'px');
        };

        card.addEventListener('mousemove', (e) => {
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => updateSpotlight(e.clientX, e.clientY));
        });

        card.addEventListener('mouseleave', () => {
          if (rafId) cancelAnimationFrame(rafId);
          card.style.removeProperty('--mx');
          card.style.removeProperty('--my');
        });

        // Keyboard focus: static position
        card.addEventListener('focus', () => {
          card.style.setProperty('--mx', '50%');
          card.style.setProperty('--my', '30%');
        });
        card.addEventListener('blur', () => {
          card.style.removeProperty('--mx');
          card.style.removeProperty('--my');
        });
      });
    }
  </script>

  <!-- Hero gradient cursor tracking (optional, only on desktop) -->
  <script>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && // i18n-ignore
        window.matchMedia('(min-width: 1024px)').matches) {
      const heroName = document.querySelector('.hero-name-text.chrome-text');
      if (heroName) {
        let rafId = null;
        document.addEventListener('mousemove', (e) => {
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            const x = (e.clientX / window.innerWidth) * 100;
            const y = (e.clientY / window.innerHeight) * 100;
            heroName.style.backgroundPosition = `${x}% ${y}%`;
          });
        });
      }
    }
  </script>

  <style>
    /* Data notice: plain sentence, not micro-caps. The label style used by the
       rest of the form is uppercase with wide tracking, which turns a full
       sentence into an unreadable block. --text-3 keeps 5.76:1 contrast. */
    .form-privacy {
      font-family: var(--font-body);
      font-size: var(--micro-size);
      font-weight: 400;
      letter-spacing: 0;
      line-height: 1.6;
      text-transform: none;
      color: var(--text-3);
      margin: var(--space-4) 0 0;
      max-width: 52ch;
    }

    /* Turnstile widget slot. Reserves the widget's height so loading it does
       not shift the form (CLS), and keeps it aligned with the form grid. */
    .form-turnstile {
      margin-top: var(--space-3);
      min-height: 65px;
      display: flex;
      align-items: center;
    }

    /* Empty state for blog section on home — same typography as .blog-subtitle */
    .blog-empty-home {
      font-family: var(--font-body);
      font-size: var(--micro-size);
      font-weight: 400;
      letter-spacing: var(--micro-tracking);
      line-height: 1.5;
      text-transform: uppercase;
      color: var(--text-3);
      margin: 0;
      text-align: right;
      /* Allow wider than subtitle so Spanish text fits on one line */
      max-width: none;
    }

    @media (max-width: 768px) {
      .blog-empty-home {
        text-align: left;
      }
    }

    /* Scale down font on desktop when text would exceed viewport width.
       At 1366px: 0.8vw = 10.9px (0.68rem) < 0.7rem → uses scaled value.
       At larger viewports: clamps to 0.7rem (original).
       Minimum readable: 0.55rem. */
    @media (min-width: 769px) {
      .blog-empty-home {
        font-size: clamp(0.55rem, 0.8vw, var(--micro-size));
      }
    }

    /* Ensure blog section content is strictly < viewport height so snap guard
       never marks it as oversized (which would degrade scroll to proximity).
       The snap guard measures contentBottom > innerHeight + 1px; shave 2px. */
    #blog .blog-content {
      margin-bottom: -2px;
    }
  </style>

---
import '../styles/global.css';
import type { Locale } from '@/i18n';
import { getTranslator } from '@/i18n';
import { DEFAULT_OG_IMAGE, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT } from '@/lib/og';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleTags?: string[];
  locale?: Locale;
  /** Alternate URLs for other locales (hreflang). Only include real language pairs. */
  alternates?: { locale: Locale; url: string }[];
}

const {
  title,
  description = '',
  canonicalURL,
  ogTitle,
  ogDescription,
  ogImage,
  ogType = 'website',
  twitterCard = 'summary_large_image',
  articlePublishedTime,
  articleModifiedTime,
  articleTags = [],
  locale = 'en',
  alternates = [],
} = Astro.props;

const t = getTranslator(locale);

const currentURL = canonicalURL || Astro.url.href;
const pageTitle = ogTitle || title;
const pageDescription = ogDescription || description;
// Never leave the card empty: an og:image pointing at a missing file is worse
// than a generic one, because clients show a blank box either way but only the
// generic one is a real image.
const pageImage = ogImage || DEFAULT_OG_IMAGE;
const pageType = ogType;
const cardType = twitterCard;

const ogLocale = locale === 'es' ? 'es_ES' : 'en_US'; // i18n-ignore
// Open Graph alternate locales must exclude the page's own locale: announcing
// the current language as an "alternate" is a contradiction crawlers have to
// discard. `new Set` also collapses a duplicated pair.
const ogLocaleAlternates = [
  ...new Set(
    alternates
      .filter((a) => a.locale !== locale)
      .map((a) => (a.locale === 'es' ? 'es_ES' : 'en_US')) // i18n-ignore
  ),
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>
    <meta name="theme-color" content="#0a0a0c" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- hreflang alternates (only real language pairs) -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.url} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.locale === 'en')?.url || canonicalURL} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={currentURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((altLocale) => (
      <meta property="og:locale:alternate" content={altLocale} />
    ))}
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {articleTags.length > 0 && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={cardType} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <!-- Self-hosted fonts: preload the two variable faces (swap handled in CSS) -->
    <link
      rel="preload"
      href="/fonts/syne-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />
  </head>
  <body>
    <!-- First focusable element on every page: one Tab reaches it, Enter jumps
         past the fixed header to the content. Hidden until focused, so it never
         occupies space or affects the layout. -->
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
    <slot />
    <!-- Saved-choice notice: appears only when the page language differs from
         the visitor's saved preference. Never redirects; dismissible. -->
    <div id="saved-choice-notice" class="saved-choice-notice" hidden role="status" aria-live="polite"
         data-text-en="You previously chose English."
         data-text-es="You previously chose Spanish."
         data-link-en="Switch to English"
         data-link-es="Switch to Spanish">
      <span class="saved-choice-text"></span>
      <a class="saved-choice-link" href="#"></a>
      <button type="button" class="saved-choice-dismiss" aria-label={t('a11y.closeMenu')}>×</button>
    </div>
    <script is:inline>
      (function () {
        var STORAGE_KEY = 'preferred-locale';
        var notice = document.getElementById('saved-choice-notice');
        if (!notice) return;

        var pageLocale = document.documentElement.lang || 'en';
        var saved = null;
        var savedAt = null;
        try {
          saved = localStorage.getItem(STORAGE_KEY);
          savedAt = localStorage.getItem(STORAGE_KEY + '-at');
        } catch (e) { return; }
        // 30-day expiry
        if (savedAt) {
          var age = Date.now() - parseInt(savedAt, 10);
          if (age > 30 * 24 * 60 * 60 * 1000) {
            try { localStorage.removeItem(STORAGE_KEY); localStorage.removeItem(STORAGE_KEY + '-at'); } catch (e) {}
            return;
          }
        }
        if (!saved || saved === pageLocale) return;

        // Build the target from the same URL map the switcher uses (single
        // source of truth, only real pairs). No regex, no blind prefix.
        var path = location.pathname;
        var pairs = {
          '/': '/es/',
          '/es/': '/',
          '/blog/': '/es/blog/',
          '/es/blog/': '/blog/',
        };
        var targetPath = pairs[path] || path;
        if (targetPath === path && saved === 'es' && path.indexOf('/es/') !== 0) {
          // Article without a Spanish version -> Spanish blog index.
          targetPath = '/es/blog/#sin-traduccion';
        } else if (targetPath === path && saved === 'en' && path.indexOf('/es/') === 0) {
          targetPath = '/blog/';
        }

        var textEl = notice.querySelector('.saved-choice-text');
        var linkEl = notice.querySelector('.saved-choice-link');
        var dismissEl = notice.querySelector('.saved-choice-dismiss');

        if (textEl) textEl.textContent = notice.getAttribute('data-text-' + saved);
        if (linkEl) {
          linkEl.href = targetPath + location.search + location.hash;
          linkEl.textContent = notice.getAttribute('data-link-' + saved);
        }

        notice.removeAttribute('hidden');
        // Add temporary bottom padding to body while notice is visible
        document.body.style.paddingBottom = (notice.offsetHeight + 32) + 'px';

        function dismiss() {
          notice.setAttribute('hidden', '');
          document.body.style.paddingBottom = '';
          try { localStorage.setItem('saved-choice-dismissed', '1'); localStorage.setItem('saved-choice-dismissed-at', String(Date.now())); } catch (e) {}
        }
        // Check if dismissed within last 30 days
        try {
          var dismissed = localStorage.getItem('saved-choice-dismissed');
          var dismissedAt = localStorage.getItem('saved-choice-dismissed-at');
          if (dismissed === '1' && dismissedAt) {
            var dage = Date.now() - parseInt(dismissedAt, 10);
            if (dage < 30 * 24 * 60 * 60 * 1000) {
              notice.setAttribute('hidden', '');
              return;
            }
          }
        } catch (e) {}
        if (dismissEl) dismissEl.addEventListener('click', dismiss);
        // Escape key dismisses
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !notice.hasAttribute('hidden')) dismiss();
        });

        // (dismissal check already handled above)
      })();
    </script>
    <script is:inline>
      (function () {
        // Snap guard: switch to 'proximity' when any section exceeds the viewport.
        // This prevents wheel snapping from getting stuck on oversized sections.
        var html = document.documentElement;
        var sections = document.querySelectorAll('#hero, #projects, #blog, #how-i-work, #contact');
        var ro = new ResizeObserver(function () {
          var oversized = false;
          for (var i = 0; i < sections.length; i++) {
            // Measure the CONTENT, not the box: .section has min-height: 100svh,
            // so a few px of bottom padding would make the box taller than the
            // viewport and degrade the whole document to proximity snapping.
            var rect = sections[i].getBoundingClientRect();
            var nodes = sections[i].querySelectorAll('*');
            var contentBottom = 0;
            for (var j = 0; j < nodes.length; j++) {
              var bottom = nodes[j].getBoundingClientRect().bottom - rect.top;
              if (bottom > contentBottom) contentBottom = bottom;
            }
            if (contentBottom > window.innerHeight + 1) {
              oversized = true;
              break;
            }
          }
          var snap = oversized ? 'proximity' : 'mandatory';
          html.setAttribute('data-snap', oversized ? 'loose' : 'tight');
          // Use setProperty with important to override CSS
          // scroll-snap-type controlled via CSS [data-snap] attribute
        });
        // Initial check after fonts load
        document.fonts.ready.then(function () {
          for (var i = 0; i < sections.length; i++) {
            ro.observe(sections[i]);
          }
        });
        // Re-check on resize/orientation change
        window.addEventListener('resize', function () {
          // Force re-evaluation by triggering a dummy resize on observed elements
          for (var i = 0; i < sections.length; i++) {
            sections[i].dispatchEvent(new Event('resize'));
          }
        });
      })();
    </script>
    <style is:global>
      /* Skip link: parked above the viewport until it receives focus, then it
         drops over the header. Same type treatment as the site's micro labels
         and the same border/colour tokens, so it reads as part of the design
         rather than a browser default. */
      .skip-link {
        position: fixed;
        top: var(--space-3);
        left: var(--space-3);
        z-index: 300;
        transform: translateY(calc(-100% - var(--space-4)));
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--text);
        padding: var(--space-3) var(--space-5);
        font-family: var(--font-body);
        font-size: var(--micro-size);
        font-weight: var(--micro-weight);
        letter-spacing: var(--micro-tracking);
        line-height: 1;
        text-transform: uppercase;
        text-decoration: none;
        transition: transform var(--transition-fast);
      }
      .skip-link:focus,
      .skip-link:focus-visible {
        transform: translateY(0);
        outline: 2px solid var(--text);
        outline-offset: 3px;
      }
      /* The skip target is a container, not a control: a full-viewport ring
         around all content would be noise, and the scroll jump is the feedback. */
      #main:focus {
        outline: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .skip-link { transition: none; }
      }

      .saved-choice-notice {
        position: fixed;
        bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        background: var(--surface-hover-strong, #1a1a1e);
        border: 1px solid var(--line-strong, #333);
        color: var(--text, #fff);
        font-family: var(--font-body);
        font-size: var(--micro-size);
        letter-spacing: var(--micro-tracking);
        text-transform: uppercase;
        max-width: calc(100vw - 2rem);
        box-shadow: 0 4px 16px rgba(0,0,0,0.4);
        padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
      }
      .saved-choice-notice[hidden] { display: none; }
      .saved-choice-link {
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .saved-choice-dismiss {
        background: transparent;
        border: none;
        color: var(--text-3);
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0 0.25rem;
        line-height: 1;
      }
      .saved-choice-dismiss:hover,
      .saved-choice-dismiss:focus-visible {
        color: var(--text);
      }
    </style>
    <!-- oneko: chasing cat cursor (self-initializing) -->
    <script is:inline src="/js/oneko.min.js" data-cat="/js/oneko.gif"></script>
  </body>
</html>